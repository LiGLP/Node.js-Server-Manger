{
  "name": "node-server-manager",
  "version": "1.0.0",
  "description": "Desktop app to manage local Node.js servers, with a login-protected web panel for remote access.",
  "main": "main.js",
  "author": "LiGLP",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pidusage": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.liglp.nodeservermanager",
    "productName": "Node Server Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Node Server Manager",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "public/**/*"
    ],
    "asar": true
  }
}
